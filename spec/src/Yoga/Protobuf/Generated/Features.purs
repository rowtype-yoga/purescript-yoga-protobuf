encodeEverything message = encodeWith writeEverything message

-- | Reads `Everything` from the bytes between two positions, for the messages it's in.
readEverything :: Reader Everything
readEverything = mkFn3 \input start end -> do
  let
    loop position scalars optionals repeateds maps choice tree outer keywords uses wide empty
      | position >= end = Right
          { scalars
          , optionals
          , repeateds
          , maps
          , choice
          , tree
          , outer
          , keywords
          , uses
          , wide
          , empty
          }
      | otherwise = do
          let afterTag = Wire.varintEnd input position end
          if afterTag < 0 then Left (failure afterTag position)
          else case Wire.varint32 input position of
            10 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readScalars input payload next of
                Left error -> Left error
                Right decoded -> loop next (Just decoded) optionals repeateds maps choice tree outer keywords uses wide empty
            18 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readOptionals input payload next of
                Left error -> Left error
                Right decoded -> loop next scalars (Just decoded) repeateds maps choice tree outer keywords uses wide empty
            26 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readRepeateds input payload next of
                Left error -> Left error
                Right decoded -> loop next scalars optionals (Just decoded) maps choice tree outer keywords uses wide empty
            34 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readMaps input payload next of
                Left error -> Left error
                Right decoded -> loop next scalars optionals repeateds (Just decoded) choice tree outer keywords uses wide empty
            42 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readChoice input payload next of
                Left error -> Left error
                Right decoded -> loop next scalars optionals repeateds maps (Just decoded) tree outer keywords uses wide empty
            50 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readTree input payload next of
                Left error -> Left error
                Right decoded -> loop next scalars optionals repeateds maps choice (Just decoded) outer keywords uses wide empty
            58 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readOuter input payload next of
                Left error -> Left error
                Right decoded -> loop next scalars optionals repeateds maps choice tree (Just decoded) keywords uses wide empty
            66 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readKeywords input payload next of
                Left error -> Left error
                Right decoded -> loop next scalars optionals repeateds maps choice tree outer (Just decoded) uses wide empty
            74 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readUses input payload next of
                Left error -> Left error
                Right decoded -> loop next scalars optionals repeateds maps choice tree outer keywords (Just decoded) wide empty
            82 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readWide input payload next of
                Left error -> Left error
                Right decoded -> loop next scalars optionals repeateds maps choice tree outer keywords uses (Just decoded) empty
            90 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readEmpty input payload next of
                Left error -> Left error
                Right decoded -> loop next scalars optionals repeateds maps choice tree outer keywords uses wide (Just decoded)
            tag -> do
              let next = Wire.skip input tag afterTag end
              if next < 0 then Left (failure next afterTag)
              else loop next scalars optionals repeateds maps choice tree outer keywords uses wide empty
  loop start Nothing Nothing Nothing Nothing Nothing Nothing Nothing Nothing Nothing Nothing Nothing

-- | Writes `Everything` back to front, for the messages it's in.
writeEverything :: Writer -> Everything -> Effect Unit
writeEverything writer message = do
  case message.empty of
    Nothing -> pure unit
    Just empty -> do
      mark <- Writer.written writer
      writeEmpty writer empty
      Writer.lengthSince writer mark
      Writer.tag writer 90
  case message.wide of
    Nothing -> pure unit
    Just wide -> do
      mark <- Writer.written writer
      writeWide writer wide
      Writer.lengthSince writer mark
      Writer.tag writer 82
  case message.uses of
    Nothing -> pure unit
    Just uses -> do
      mark <- Writer.written writer
      writeUses writer uses
      Writer.lengthSince writer mark
      Writer.tag writer 74
  case message.keywords of
    Nothing -> pure unit
    Just keywords -> do
      mark <- Writer.written writer
      writeKeywords writer keywords
      Writer.lengthSince writer mark
      Writer.tag writer 66
  case message.outer of
    Nothing -> pure unit
    Just outer -> do
      mark <- Writer.written writer
      writeOuter writer outer
      Writer.lengthSince writer mark
      Writer.tag writer 58
  case message.tree of
    Nothing -> pure unit
    Just tree -> do
      mark <- Writer.written writer
      writeTree writer tree
      Writer.lengthSince writer mark
      Writer.tag writer 50
  case message.choice of
    Nothing -> pure unit
    Just choice -> do
      mark <- Writer.written writer
      writeChoice writer choice
      Writer.lengthSince writer mark
      Writer.tag writer 42
  case message.maps of
    Nothing -> pure unit
    Just maps -> do
      mark <- Writer.written writer
      writeMaps writer maps
      Writer.lengthSince writer mark
      Writer.tag writer 34
  case message.repeateds of
    Nothing -> pure unit
    Just repeateds -> do
      mark <- Writer.written writer
      writeRepeateds writer repeateds
      Writer.lengthSince writer mark
      Writer.tag writer 26
  case message.optionals of
    Nothing -> pure unit
    Just optionals -> do
      mark <- Writer.written writer
      writeOptionals writer optionals
      Writer.lengthSince writer mark
      Writer.tag writer 18
  case message.scalars of
    Nothing -> pure unit
    Just scalars -> do
      mark <- Writer.written writer
      writeScalars writer scalars
      Writer.lengthSince writer mark
      Writer.tag writer 10
