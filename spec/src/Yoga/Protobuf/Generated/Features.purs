-- | Writes `Repeateds` back to front, for the messages it's in.
writeRepeateds :: Writer -> Repeateds -> Effect Unit
writeRepeateds writer message = do
  Writer.eachDescending message.unpackedColours \item -> do
    Writer.int32 writer (fromColour item)
    Writer.tag writer 160
  Writer.eachDescending message.unpackedDoubles \item -> do
    Writer.double writer item
    Writer.tag writer 153
  Writer.eachDescending message.unpackedInt32s \item -> do
    Writer.int32 writer item
    Writer.tag writer 144
  Writer.eachDescending message.messages \item -> do
    mark <- Writer.written writer
    writeScalars writer item
    Writer.lengthSince writer mark
    Writer.tag writer 138
  when (not (Array.null message.colours)) do
    mark <- Writer.written writer
    Writer.eachDescending message.colours \item -> Writer.int32 writer (fromColour item)
    Writer.lengthSince writer mark
    Writer.tag writer 130
  Writer.eachDescending message.byteStrings \item -> do
    Writer.bytes writer item
    Writer.tag writer 122
  Writer.eachDescending message.strings \item -> do
    Writer.string writer item
    Writer.tag writer 114
  when (not (Array.null message.bools)) do
    mark <- Writer.written writer
    Writer.eachDescending message.bools \item -> Writer.bool writer item
    Writer.lengthSince writer mark
    Writer.tag writer 106
  when (not (Array.null message.sfixed64s)) do
    mark <- Writer.written writer
    Writer.eachDescending message.sfixed64s \item -> Writer.fixed64 writer item
    Writer.lengthSince writer mark
    Writer.tag writer 98
  when (not (Array.null message.sfixed32s)) do
    mark <- Writer.written writer
    Writer.eachDescending message.sfixed32s \item -> Writer.fixed32 writer item
    Writer.lengthSince writer mark
    Writer.tag writer 90
  when (not (Array.null message.fixed64s)) do
    mark <- Writer.written writer
    Writer.eachDescending message.fixed64s \item -> Writer.fixed64 writer (un UInt64 item)
    Writer.lengthSince writer mark
    Writer.tag writer 82
  when (not (Array.null message.fixed32s)) do
    mark <- Writer.written writer
    Writer.eachDescending message.fixed32s \item -> Writer.fixed32 writer (un UInt32 item)
    Writer.lengthSince writer mark
    Writer.tag writer 74
  when (not (Array.null message.sint64s)) do
    mark <- Writer.written writer
    Writer.eachDescending message.sint64s \item -> Writer.sint64 writer item
    Writer.lengthSince writer mark
    Writer.tag writer 66
  when (not (Array.null message.sint32s)) do
    mark <- Writer.written writer
    Writer.eachDescending message.sint32s \item -> Writer.sint32 writer item
    Writer.lengthSince writer mark
    Writer.tag writer 58
  when (not (Array.null message.uint64s)) do
    mark <- Writer.written writer
    Writer.eachDescending message.uint64s \item -> Writer.int64 writer (un UInt64 item)
    Writer.lengthSince writer mark
    Writer.tag writer 50
  when (not (Array.null message.uint32s)) do
    mark <- Writer.written writer
    Writer.eachDescending message.uint32s \item -> Writer.uint32 writer (un UInt32 item)
    Writer.lengthSince writer mark
    Writer.tag writer 42
  when (not (Array.null message.int64s)) do
    mark <- Writer.written writer
    Writer.eachDescending message.int64s \item -> Writer.int64 writer item
    Writer.lengthSince writer mark
    Writer.tag writer 34
  when (not (Array.null message.int32s)) do
    mark <- Writer.written writer
    Writer.eachDescending message.int32s \item -> Writer.int32 writer item
    Writer.lengthSince writer mark
    Writer.tag writer 26
  when (not (Array.null message.floats)) do
    mark <- Writer.written writer
    Writer.eachDescending message.floats \item -> Writer.float writer item
    Writer.lengthSince writer mark
    Writer.tag writer 18
  when (not (Array.null message.doubles)) do
    mark <- Writer.written writer
    Writer.eachDescending message.doubles \item -> Writer.double writer item
    Writer.lengthSince writer mark
