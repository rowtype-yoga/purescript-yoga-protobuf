-- | `features.Maps`.
type Maps =
  { byName :: Map String Int
  , messages :: Map Int Scalars
  , colours :: Map UInt32 Colour
  , byInt64 :: Map Int64 String
  , byBool :: Map Boolean Bytes
  , bySint32 :: Map Int Number
  , things :: Map UInt64 Imported.Thing
  }

-- | Every field at its default: what decoding no bytes gives.
defaultMaps :: Maps
defaultMaps =
  { byName: Map.empty
  , messages: Map.empty
  , colours: Map.empty
  , byInt64: Map.empty
  , byBool: Map.empty
  , bySint32: Map.empty
  , things: Map.empty
  }

-- | Decodes and encodes `Maps`.
mapsCodec :: Codec Maps
mapsCodec = codec readMaps writeMaps

-- | Broken input is a `Left` that says where it went wrong.
decodeMaps :: Bytes -> Either DecodeError Maps
decodeMaps input = decodeMessage readMaps input

-- | The fields in the order of their numbers; a map's entries in the order of their keys.
encodeMaps :: Maps -> Bytes
encodeMaps message = encodeWith writeMaps message

-- | Reads `Maps` from the bytes between two positions, for the messages it's in.
readMaps :: Reader Maps
readMaps = mkFn3 \input start end -> do
  let
    loop position byName messages colours byInt64 byBool bySint32 things
      | position >= end = Right
          { byName: mapFromEntries byName
          , messages: mapFromEntries messages
          , colours: mapFromEntries colours
          , byInt64: mapFromEntries byInt64
          , byBool: mapFromEntries byBool
          , bySint32: mapFromEntries bySint32
          , things: mapFromEntries things
          }
      | otherwise = do
          let afterTag = Wire.varintEnd input position end
          if afterTag < 0 then Left (failure afterTag position)
          else case Wire.varint32 input position of
            10 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readMaps_ByNameEntry input payload next of
                Left error -> Left error
                Right decoded -> loop next (Repeated.snoc byName decoded) messages colours byInt64 byBool bySint32 things
            18 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readMaps_MessagesEntry input payload next of
                Left error -> Left error
                Right decoded -> loop next byName (Repeated.snoc messages decoded) colours byInt64 byBool bySint32 things
            26 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readMaps_ColoursEntry input payload next of
                Left error -> Left error
                Right decoded -> loop next byName messages (Repeated.snoc colours decoded) byInt64 byBool bySint32 things
            34 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readMaps_ByInt64Entry input payload next of
                Left error -> Left error
                Right decoded -> loop next byName messages colours (Repeated.snoc byInt64 decoded) byBool bySint32 things
            42 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readMaps_ByBoolEntry input payload next of
                Left error -> Left error
                Right decoded -> loop next byName messages colours byInt64 (Repeated.snoc byBool decoded) bySint32 things
            50 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readMaps_BySint32Entry input payload next of
                Left error -> Left error
                Right decoded -> loop next byName messages colours byInt64 byBool (Repeated.snoc bySint32 decoded) things
            58 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else case runFn3 readMaps_ThingsEntry input payload next of
                Left error -> Left error
                Right decoded -> loop next byName messages colours byInt64 byBool bySint32 (Repeated.snoc things decoded)
            tag -> do
              let next = Wire.skip input tag afterTag end
              if next < 0 then Left (failure next afterTag)
              else loop next byName messages colours byInt64 byBool bySint32 things
  loop start Repeated.empty Repeated.empty Repeated.empty Repeated.empty Repeated.empty Repeated.empty Repeated.empty

-- | Writes `Maps` back to front, for the messages it's in.
writeMaps :: Writer -> Maps -> Effect Unit
writeMaps writer message = do
  Writer.eachEntryDescending message.things \key value -> do
    mark <- Writer.written writer
    valueMark <- Writer.written writer
    Imported.writeThing writer value
    Writer.lengthSince writer valueMark
    Writer.tag writer 18
    Writer.fixed64 writer (un UInt64 key)
    Writer.tag writer 9
    Writer.lengthSince writer mark
    Writer.tag writer 58
  Writer.eachEntryDescending message.bySint32 \key value -> do
    mark <- Writer.written writer
    Writer.double writer value
    Writer.tag writer 17
    Writer.sint32 writer key
    Writer.tag writer 8
    Writer.lengthSince writer mark
    Writer.tag writer 50
  Writer.eachEntryDescending message.byBool \key value -> do
    mark <- Writer.written writer
    Writer.bytes writer value
    Writer.tag writer 18
    Writer.bool writer key
    Writer.tag writer 8
    Writer.lengthSince writer mark
    Writer.tag writer 42
  Writer.eachEntryDescending message.byInt64 \key value -> do
    mark <- Writer.written writer
    Writer.string writer value
    Writer.tag writer 18
    Writer.int64 writer key
    Writer.tag writer 8
    Writer.lengthSince writer mark
    Writer.tag writer 34
  Writer.eachEntryDescending message.colours \key value -> do
    mark <- Writer.written writer
    Writer.int32 writer (fromColour value)
    Writer.tag writer 16
    Writer.uint32 writer (un UInt32 key)
    Writer.tag writer 8
    Writer.lengthSince writer mark
    Writer.tag writer 26
  Writer.eachEntryDescending message.messages \key value -> do
    mark <- Writer.written writer
    valueMark <- Writer.written writer
    writeScalars writer value
    Writer.lengthSince writer valueMark
    Writer.tag writer 18
    Writer.int32 writer key
    Writer.tag writer 8
    Writer.lengthSince writer mark
    Writer.tag writer 18
  Writer.eachEntryDescending message.byName \key value -> do
    mark <- Writer.written writer
    Writer.int32 writer value
    Writer.tag writer 16
    Writer.string writer key
    Writer.tag writer 10
    Writer.lengthSince writer mark
    Writer.tag writer 10

readMaps_ByNameEntry :: Reader (Entry String Int)
readMaps_ByNameEntry = mkFn3 \input start end -> do
  let
    loop position key value
      | position >= end = Right { key, value }
      | otherwise = do
          let afterTag = Wire.varintEnd input position end
          if afterTag < 0 then Left (failure afterTag position)
          else case Wire.varint32 input position of
            10 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else do
                let text = Wire.string input payload next
                if text == Wire.invalidUtf8 then Left (InvalidUtf8 payload)
                else loop next text value
            16 -> do
              let next = Wire.varintEnd input afterTag end
              if next < 0 then Left (failure next afterTag)
              else loop next key (Wire.varint32 input afterTag)
            tag -> do
              let next = Wire.skip input tag afterTag end
              if next < 0 then Left (failure next afterTag)
              else loop next key value
  loop start "" 0

