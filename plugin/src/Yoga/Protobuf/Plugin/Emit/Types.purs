-- | The PureScript module for one `.proto` file as yoga-connect's types, the default: each
-- | message a `Message` of numbered fields, each enum a sum type with `Generic`, each service a
-- | `Service` of its methods. yoga-connect works out the codecs, the server, the client and the
-- | `.proto` from them, so there's no code in the module, only types.
-- |
-- | ```purescript
-- | type Ticker = TickerWith () ()
-- |
-- | type TickerWith tradeErrors watchErrors = Service "ticker.v1.Ticker"
-- |   { watch :: ServerStream Subscribe Quote watchErrors
-- |   , trade :: BidiStream Trade Fill tradeErrors
-- |   }
-- |
-- | type Quote = Named "Quote" (Message { symbol :: 1 := String, price :: 2 := Number })
-- | ```
-- |
-- | A `.proto` can't say how a method fails, so `Ticker` has no errors. `TickerWith` takes a row
-- | of errors per method, in the order of the methods' names (so reordering the `.proto` changes
-- | nothing), for a service type of your own:
-- |
-- | ```purescript
-- | type Ticker = TickerWith (notFound :: String, failedPrecondition :: String) (notFound :: String)
-- | ```
-- |
-- | A message is `Named` when `printProto` wouldn't otherwise give it its name back: when it's
-- | a method's request, which would be `WatchRequest`, or the type of a field not named after
-- | it. An enum is `Named` where it's used, for the same reason.
module Yoga.Protobuf.Plugin.Emit.Types
  ( Uses
  , usesIn
  , typesModuleFor
  ) where

import Prelude

import Data.Array as Array
import Data.Either (Either(..))
import Data.Foldable (any, traverse_)
import Data.Map (Map)
import Data.Map as Map
import Data.Maybe (Maybe(..), maybe)
import Data.String as String
import Data.String.Pattern (Pattern(..))
import Data.Tuple.Nested (type (/\), (/\))

import Yoga.Protobuf.Plugin.Emit.Code (indentBy, parenthesised)
import Yoga.Protobuf.Plugin.Imports (typeImportsFor)
import Yoga.Protobuf.Plugin.Names (upperFirst)
import Yoga.Protobuf.Plugin.Schema (EnumModel, Field, FileModel, Member(..), MessageModel, MethodModel, Reference, Schema, ServiceModel, Shape(..), Streaming(..), ValueType(..))

-- | The names `printProto` would give each message and enum, by its full name, where it's used:
-- | a method's request is `WatchRequest`, a field's type is named after the field.
type Uses = Map String (Array String)

-- | Where the messages and enums of the files are used, in any of them.
usesIn :: Schema -> Uses
usesIn schema = Map.fromFoldableWith (<>) (schema >>= usesInFile)
  where
  usesInFile file = (file.messages >>= usesInMessage) <> (file.services >>= _.methods >>= usesInMethod)
  usesInMethod method =
    [ method.request.fullName /\ [ method.name <> "Request" ]
    , method.response.fullName /\ [ method.name <> "Response" ]
    ]
  usesInMessage message = message.members >>= case _ of
    Plain field -> usesInField field
    Oneof oneof -> oneof.fields >>= usesInField
  usesInField field = case field.shape of
    MapOf entry -> usedAs "Value" entry.value
    _ -> usedAs (upperFirst field.label) field.value
  usedAs name = referenceOf >>> maybe [] \reference -> [ reference.fullName /\ [ name ] ]

-- | The module's text, or why the file can't be types: what yoga-connect's messages can't say.
typesModuleFor :: Uses -> FileModel -> Either String String
typesModuleFor uses file = do
  unless file.proto3 (Left (file.protoName <> ": yoga-connect's messages are proto3; generate proto2 files with the option legacy"))
  traverse_ checkMessage file.messages
  traverse_ checkEnum file.enums
  traverse_ checkService file.services
  pure (String.joinWith "\n" lines <> "\n")
  where
  lines = case body of
    [] -> [ documentation, "module " <> file.moduleName <> " where" ]
    _ -> [ documentation, "module " <> file.moduleName <> " where", "" ] <> imports <> [ "" ] <> body
  documentation = "-- | Generated by protoc-gen-purescript from " <> file.protoName <> ". Don't edit it by hand."
  imports = typeImportsFor { derives: not (Array.null file.enums), ownNames } file.imports body
  body = Array.intercalate [ "" ] ((file.services >>= serviceDeclarations naming) <> (file.messages <#> messageDeclaration naming) <> (file.enums <#> enumDeclaration))
  naming = { uses, library }
  ownNames = (file.messages <#> _.name) <> (file.enums <#> _.name) <> (file.services >>= \service -> [ service.typeName, withErrors service ])
  library name = if Array.elem name ownNames then qualifierOf name <> name else name

-- | How the module names things: library types qualified if the module has its own of that name.
type Naming = { uses :: Uses, library :: String -> String }

-- Services

-- | The service without errors, and the service with a row of errors for each method.
serviceDeclarations :: Naming -> ServiceModel -> Array (Array String)
serviceDeclarations naming service = case service.methods of
  [] -> [ documentation <> [ "type " <> service.typeName <> " = " <> serviceType <> " {}" ] ]
  methods ->
    [ documentation <> [ "type " <> service.typeName <> " = " <> String.joinWith " " ([ withErrors service ] <> (methods $> "()")) ]
    , [ "-- | `" <> service.typeName <> "` with the errors its methods reject calls with, a row for each, by name."
      , "type " <> String.joinWith " " ([ withErrors service ] <> (Array.sortWith _.label methods <#> errorsOf)) <> " = " <> serviceType
      ]
        <> indentBy 2 (recordLines (methods <#> methodType))
    ]
  where
  serviceType = naming.library "Service" <> " " <> show service.fullName
  documentation = commentLines service.comment <> methodComments
  methodComments = case Array.mapMaybe methodComment service.methods of
    [] -> []
    described -> (if service.comment == Nothing then [ "-- | `" <> service.fullName <> "`." ] else []) <> [ "-- |" ] <> described
  methodComment method = method.comment <#> \comment -> "-- | - `" <> method.label <> "`: " <> String.joinWith " " (commentText comment)
  methodType method = String.joinWith " " [ method.label, "::", naming.library (kindOf method.streaming), messageOf method.request, messageOf method.response, errorsOf method ]
  messageOf reference = reference.qualifier <> reference.name
  errorsOf method = method.label <> "Errors"
  kindOf = case _ of
    NoStreams -> "Unary"
    ServerStreams -> "ServerStream"
    ClientStreams -> "ClientStream"
    BothStreams -> "BidiStream"

-- | `TickerWith`, the service with errors.
withErrors :: ServiceModel -> String
withErrors service = service.typeName <> "With"

-- Messages

messageDeclaration :: Naming -> MessageModel -> Array String
messageDeclaration naming message = commentLines message.comment <> declaration
  where
  declaration
    | String.length oneLine <= 100 = [ oneLine ]
    | needsName = [ start <> naming.library "Named" <> " " <> show protoName, "  ( " <> messageType ] <> indentBy 6 fieldLines <> [ "  )" ]
    | otherwise = [ start <> messageType ] <> indentBy 2 fieldLines
  oneLine = start <> named (messageType <> " " <> recordOf fields)
  start = "type " <> message.name <> " = "
  messageType = naming.library "Message"
  named text = if needsName then naming.library "Named" <> " " <> show protoName <> " (" <> text <> ")" else text
  needsName = Map.lookup message.fullName naming.uses # maybe false (any (_ /= protoName))
  protoName = lastSegment message.fullName
  fields = message.members <#> memberText naming
  fieldLines = recordLines fields

memberText :: Naming -> Member -> String
memberText naming = case _ of
  Plain field -> field.label <> " :: " <> show field.number <> " := " <> fieldType naming field
  Oneof oneof -> oneof.label <> " :: " <> naming.library "OneOf" <> " (" <> String.joinWith ", " (oneof.fields <#> alternative) <> ")"
  where
  alternative field = field.label <> " :: " <> show field.number <> " := " <> valueText naming (upperFirst field.label) field.value

-- | `Array String` for `repeated string`, `Maybe Int` for `optional int32`. A message field is
-- | the message: it's always written, so a client can tell it from one left out.
fieldType :: Naming -> Field -> String
fieldType naming field = case field.shape of
  Implicit -> value
  Required -> value
  InOneof -> value
  Optional
    | field.declaredOptional -> naming.library "Maybe" <> " " <> parenthesised value
    | otherwise -> value
  Repeated _ -> "Array " <> parenthesised value
  MapOf entry -> "Array (" <> naming.library "Named" <> " " <> show entry.protoName <> " (" <> naming.library "Message" <> " " <> entryRecord entry <> "))"
  where
  value = valueText naming (upperFirst field.label) field.value
  entryRecord entry = recordOf [ "key :: 1 := " <> valueText naming "Key" entry.key, "value :: 2 := " <> valueText naming "Value" entry.value ]

-- | The type of a value where `printProto` would call it `inferred`: an enum by another name is
-- | `Named` there.
valueText :: Naming -> String -> ValueType -> String
valueText naming inferred = case _ of
  EnumValue reference
    | lastSegment reference.fullName /= inferred -> naming.library "Named" <> " " <> show (lastSegment reference.fullName) <> " " <> referenceText reference
    | otherwise -> referenceText reference
  MessageValue reference -> referenceText reference
  DoubleValue -> "Number"
  StringValue -> "String"
  BoolValue -> "Boolean"
  BytesValue -> naming.library "Bytes"
  Int32Value -> "Int"
  Int64Value -> naming.library "Int64"
  UInt32Value -> naming.library "UInt32"
  UInt64Value -> naming.library "UInt64"
  -- Refused by `checkMessage`.
  FloatValue -> "Number"
  SInt32Value -> "Int"
  SInt64Value -> naming.library "Int64"
  Fixed32Value -> naming.library "UInt32"
  Fixed64Value -> naming.library "UInt64"
  SFixed32Value -> "Int"
  SFixed64Value -> naming.library "Int64"
  where
  referenceText reference = reference.qualifier <> reference.name

-- Enums

-- | A sum type of constructors without arguments, numbered from 0 in their order.
enumDeclaration :: EnumModel -> Array String
enumDeclaration enum = Array.intercalate [ "" ]
  [ commentLines enum.comment <> dataDeclaration
  , [ "derive instance Generic " <> enum.name <> " _" ]
  , [ "derive instance Eq " <> enum.name ]
  , [ "derive instance Ord " <> enum.name ]
  , [ "instance Show " <> enum.name <> " where", "  show = genericShow" ]
  ]
  where
  constructors = enum.constructors <#> _.constructor
  oneLine = "data " <> enum.name <> " = " <> String.joinWith " | " constructors
  dataDeclaration
    | String.length oneLine <= 100 = [ oneLine ]
    | otherwise = [ "data " <> enum.name ] <> Array.mapWithIndex (\index constructor -> (if index == 0 then "  = " else "  | ") <> constructor) constructors

-- What the types can't say

checkMessage :: MessageModel -> Either String Unit
checkMessage message = do
  when message.recursive (Left (message.fullName <> " refers to itself, which a type synonym can't; generate it with the option legacy"))
  traverse_ checkField (message.members >>= fieldsOfMember)
  where
  fieldsOfMember = case _ of
    Plain field -> [ field ]
    Oneof oneof -> oneof.fields
  checkField field = traverse_ (checkValue field) (valuesOf field)
  valuesOf field = case field.shape of
    MapOf entry -> [ entry.key, entry.value ]
    _ -> [ field.value ]
  checkValue field value = case unsupported value of
    Just protoType -> Left (message.fullName <> "." <> field.label <> ": yoga-connect's messages have no " <> protoType <> "; use " <> instead protoType <> ", or generate with the option legacy")
    Nothing -> Right unit
  instead = case _ of
    "float" -> "double"
    "sint32" -> "int32"
    "sfixed32" -> "int32"
    "fixed32" -> "uint32"
    "fixed64" -> "uint64"
    _ -> "int64"

-- | The protocol buffer types a message type can't have, which go over the wire differently from
-- | the ones it has.
unsupported :: ValueType -> Maybe String
unsupported = case _ of
  FloatValue -> Just "float"
  SInt32Value -> Just "sint32"
  SInt64Value -> Just "sint64"
  Fixed32Value -> Just "fixed32"
  Fixed64Value -> Just "fixed64"
  SFixed32Value -> Just "sfixed32"
  SFixed64Value -> Just "sfixed64"
  _ -> Nothing

-- | yoga-connect numbers an enum's constructors 0, 1, 2, … in their order.
checkEnum :: EnumModel -> Either String Unit
checkEnum enum
  | (enum.constructors <#> _.number) == Array.range 0 (Array.length enum.constructors - 1) = Right unit
  | otherwise = Left (enum.fullName <> ": an enum's values need the numbers 0, 1, 2, … in their order; generate it with the option legacy")

-- | The method `watch` is `/ticker.v1.Ticker/Watch`, so a method's name has to start with a
-- | capital letter.
checkService :: ServiceModel -> Either String Unit
checkService service = traverse_ checkMethod service.methods
  where
  checkMethod :: MethodModel -> Either String Unit
  checkMethod method
    | upperFirst method.label == method.name = Right unit
    | otherwise = Left (service.fullName <> "." <> method.name <> ": yoga-connect would call it " <> upperFirst method.label <> "; rename it, or generate with the option legacy")

-- Layout

-- | A record's fields on one line.
recordOf :: Array String -> String
recordOf = case _ of
  [] -> "{}"
  fields -> "{ " <> String.joinWith ", " fields <> " }"

-- | A record's fields one per line.
recordLines :: Array String -> Array String
recordLines = case _ of
  [] -> [ "{}" ]
  fields -> Array.mapWithIndex (\index field -> (if index == 0 then "{ " else ", ") <> field) fields <> [ "}" ]

-- | A comment from the `.proto` as documentation.
commentLines :: Maybe String -> Array String
commentLines = maybe [] \comment -> commentText comment <#> \line -> if line == "" then "-- |" else "-- | " <> line

-- | The lines of a comment, without the space after `//` and the blank lines around it.
commentText :: String -> Array String
commentText comment = String.split (Pattern "\n") (String.trim comment) <#> withoutLeadingSpace
  where
  withoutLeadingSpace line = String.stripPrefix (Pattern " ") line # maybe line identity

referenceOf :: ValueType -> Maybe Reference
referenceOf = case _ of
  MessageValue reference -> Just reference
  EnumValue reference -> Just reference
  _ -> Nothing

-- | The alias a library type gets when the module has a type of that name too.
qualifierOf :: String -> String
qualifierOf name = Map.lookup name qualifiers # maybe "" (_ <> ".")
  where
  qualifiers = Map.fromFoldable (aliases :: Array (String /\ String))
  aliases =
    [ "Message" /\ "Connect", "Named" /\ "Connect", "OneOf" /\ "Connect", "Service" /\ "Connect"
    , "Unary" /\ "Connect", "ServerStream" /\ "Connect", "ClientStream" /\ "Connect", "BidiStream" /\ "Connect"
    , "Maybe" /\ "Maybe", "Int64" /\ "Int64", "UInt32" /\ "Unsigned", "UInt64" /\ "Unsigned", "Bytes" /\ "Bytes"
    ]

lastSegment :: String -> String
lastSegment name = Array.last (String.split (Pattern ".") name) # maybe name identity
