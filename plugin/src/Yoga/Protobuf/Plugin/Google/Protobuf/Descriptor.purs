generatedCodeInfo_AnnotationCodec = codec readGeneratedCodeInfo_Annotation writeGeneratedCodeInfo_Annotation

-- | Broken input is a `Left` that says where it went wrong.
decodeGeneratedCodeInfo_Annotation :: Bytes -> Either DecodeError GeneratedCodeInfo_Annotation
decodeGeneratedCodeInfo_Annotation input = decodeMessage readGeneratedCodeInfo_Annotation input

-- | The fields in the order of their numbers; a map's entries in the order of their keys.
encodeGeneratedCodeInfo_Annotation :: GeneratedCodeInfo_Annotation -> Bytes
encodeGeneratedCodeInfo_Annotation message = encodeWith writeGeneratedCodeInfo_Annotation message

-- | Reads `GeneratedCodeInfo_Annotation` from the bytes between two positions, for the messages it's in.
readGeneratedCodeInfo_Annotation :: Reader GeneratedCodeInfo_Annotation
readGeneratedCodeInfo_Annotation = mkFn3 \input start end -> do
  let
    loop position path sourceFile begin end' semantic
      | position >= end = Right
          { path: Repeated.freeze path
          , sourceFile
          , begin
          , end: end'
          , semantic
          }
      | otherwise = do
          let afterTag = Wire.varintEnd input position end
          if afterTag < 0 then Left (failure afterTag position)
          else case Wire.varint32 input position of
            8 -> do
              let next = Wire.varintEnd input afterTag end
              if next < 0 then Left (failure next afterTag)
              else loop next (Repeated.snoc path (Wire.varint32 input afterTag)) sourceFile begin end' semantic
            10 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else if not (Wire.packedVarintsValid input payload next) then Left (MalformedVarint payload)
              else loop next (packedInt32 input payload next path) sourceFile begin end' semantic
            18 -> do
              let payload = Wire.varintEnd input afterTag end
              let next = Wire.delimitedEnd input afterTag payload end
              if next < 0 then Left (failure next afterTag)
              else do
                let text = Wire.string input payload next
                if text == Wire.invalidUtf8 then Left (InvalidUtf8 payload)
                else loop next path (Just text) begin end' semantic
            24 -> do
              let next = Wire.varintEnd input afterTag end
              if next < 0 then Left (failure next afterTag)
              else loop next path sourceFile (Just (Wire.varint32 input afterTag)) end' semantic
            32 -> do
              let next = Wire.varintEnd input afterTag end
              if next < 0 then Left (failure next afterTag)
              else loop next path sourceFile begin (Just (Wire.varint32 input afterTag)) semantic
            40 -> do
              let next = Wire.varintEnd input afterTag end
              if next < 0 then Left (failure next afterTag)
              else loop next path sourceFile begin end' (Just (toGeneratedCodeInfo_Annotation_Semantic (Wire.varint32 input afterTag)))
            tag -> do
              let next = Wire.skip input tag afterTag end
              if next < 0 then Left (failure next afterTag)
              else loop next path sourceFile begin end' semantic
  loop start Repeated.empty Nothing Nothing Nothing Nothing

-- | Writes `GeneratedCodeInfo_Annotation` back to front, for the messages it's in.
writeGeneratedCodeInfo_Annotation :: Writer -> GeneratedCodeInfo_Annotation -> Effect Unit
writeGeneratedCodeInfo_Annotation writer message = do
  case message.semantic of
    Nothing -> pure unit
    Just semantic -> do
      Writer.int32 writer (fromGeneratedCodeInfo_Annotation_Semantic semantic)
      Writer.tag writer 40
  case message.end of
    Nothing -> pure unit
    Just end' -> do
      Writer.int32 writer end'
      Writer.tag writer 32
  case message.begin of
    Nothing -> pure unit
    Just begin -> do
      Writer.int32 writer begin
      Writer.tag writer 24
  case message.sourceFile of
    Nothing -> pure unit
    Just sourceFile -> do
      Writer.string writer sourceFile
      Writer.tag writer 18
  when (not (Array.null message.path)) do
    mark <- Writer.written writer
    Writer.eachDescending message.path \item -> Writer.int32 writer item
    Writer.lengthSince writer mark
    Writer.tag writer 10
