-- | The PureScript module for one `.proto` file.
-- |
-- | Each message becomes a record type with a default value, a decoder that reads one field per
-- | step of a loop over local variables, an encoder that writes back to front, and a codec. Each
-- | enum becomes a data type with a constructor for numbers it doesn't know.
module Yoga.Protobuf.Plugin.Emit
  ( Options
  , moduleFor
  ) where

import Prelude

import Data.Array as Array
import Data.Foldable (foldMap, maximum)
import Data.Int.Bits (shl, (.|.))
import Data.Maybe (Maybe(..), fromMaybe)
import Data.String as String
import Data.String.Pattern (Pattern(..))
import Data.Tuple.Nested ((/\))
import Yoga.Protobuf.Plugin.Imports (importsFor)
import Yoga.Protobuf.Plugin.Schema (EnumModel, Field, FileModel, MapEntry, Member(..), MessageModel, Shape(..), ValueType(..), packable)

-- | `fieldsThreshold`: messages with at least this many fields, all of them plain values, are
-- | decoded in two steps (see `Yoga.Protobuf.Fields`).
type Options = { fieldsThreshold :: Int }

moduleFor :: Options -> FileModel -> String
moduleFor options file = String.joinWith "\n" (header <> importsFor file.imports body <> [ "" ] <> body) <> "\n"
  where
  header =
    [ "-- | Generated by protoc-gen-purescript from " <> file.protoName <> ". Don't edit it by hand."
    , "module " <> file.moduleName <> " where"
    , ""
    ]
  body = Array.intercalate [ "" ] (map enumDeclarations file.enums <> map (messageDeclarations options) file.messages)

-- Enums

enumDeclarations :: EnumModel -> Array String
enumDeclarations enum =
  [ "data " <> enum.name ]
    <> Array.mapWithIndex (\index constructor -> (if index == 0 then "  = " else "  | ") <> constructor) (map _.constructor enum.constructors <> [ enum.unrecognized <> " Int" ])
    <> [ ""
       , "derive instance Eq " <> enum.name
       , ""
       , "derive instance Ord " <> enum.name
       , ""
       , "instance Show " <> enum.name <> " where"
       , "  show = case _ of"
       ]
    <> map (\{ constructor } -> "    " <> constructor <> " -> \"" <> constructor <> "\"") enum.constructors
    <> [ "    " <> enum.unrecognized <> " number -> \"(" <> enum.unrecognized <> " \" <> show number <> \")\""
       , ""
       , "to" <> enum.name <> " :: Int -> " <> enum.name
       , "to" <> enum.name <> " = case _ of"
       ]
    <> map (\{ constructor, number } -> "  " <> show number <> " -> " <> constructor) (Array.nubBy (comparing _.number) enum.constructors)
    <> [ "  number -> " <> enum.unrecognized <> " number"
       , ""
       , "from" <> enum.name <> " :: " <> enum.name <> " -> Int"
       , "from" <> enum.name <> " = case _ of"
       ]
    <> map (\{ constructor, number } -> "  " <> constructor <> " -> " <> show number) enum.constructors
    <> [ "  " <> enum.unrecognized <> " number -> number" ]

-- Messages

messageDeclarations :: Options -> MessageModel -> Array String
messageDeclarations options message = Array.intercalate [ "" ] (declarations <> map entryReader message.entries)
  where
  codecName = lowerFirst message.name <> "Codec"
  declarations =
    [ typeDeclaration message
    , defaultDeclaration message
    , [ codecName <> " :: Codec " <> message.name
      , codecName <> " = codec read" <> message.name <> " write" <> message.name
      ]
    , [ "decode" <> message.name <> " :: Bytes -> Either DecodeError " <> message.name
      , "decode" <> message.name <> " input = decodeMessage read" <> message.name <> " input"
      ]
    , [ "encode" <> message.name <> " :: " <> message.name <> " -> Bytes"
      , "encode" <> message.name <> " message = encodeWith write" <> message.name <> " message"
      ]
    , if twoStep options message then fieldsReader message else loopReader message
    , writerDeclaration message
    ]

typeDeclaration :: MessageModel -> Array String
typeDeclaration message
  | message.recursive =
      [ "newtype " <> message.name <> " = " <> message.name ]
        <> indentBy 2 (recordType message)
        <> [ ""
           , "derive instance Newtype " <> message.name <> " _"
           , ""
           , "derive instance Eq " <> message.name
           , ""
           , "instance Show " <> message.name <> " where"
           , "  show (" <> message.name <> " record) = \"(" <> message.name <> " \" <> show record <> \")\""
           ]
  | otherwise = case recordType message of
      [ single ] -> [ "type " <> message.name <> " = " <> single ]
      lines -> [ "type " <> message.name <> " =" ] <> indentBy 2 lines

recordType :: MessageModel -> Array String
recordType message = recordLines (map member message.members)
  where
  member = case _ of
    Plain field -> field.label <> " :: " <> fieldType field
    Oneof oneof -> oneof.label <> " :: Maybe (Variant (" <> String.joinWith ", " (map (\field -> field.label <> " :: " <> valueType field.value) oneof.fields) <> "))"

fieldType :: Field -> String
fieldType field = case field.shape of
  Implicit -> valueType field.value
  Required -> valueType field.value
  Optional -> "Maybe " <> parenthesised (valueType field.value)
  Repeated _ -> "Array " <> parenthesised (valueType field.value)
  MapOf entry -> "Map " <> parenthesised (valueType entry.key) <> " " <> parenthesised (valueType entry.value)
  InOneof -> valueType field.value

valueType :: ValueType -> String
valueType = case _ of
  DoubleValue -> "Number"
  FloatValue -> "Number"
  Int64Value -> "Int64"
  UInt64Value -> "UInt64"
  Int32Value -> "Int"
  Fixed64Value -> "UInt64"
  Fixed32Value -> "UInt32"
  BoolValue -> "Boolean"
  StringValue -> "String"
  BytesValue -> "Bytes"
  UInt32Value -> "UInt32"
  SFixed32Value -> "Int"
  SFixed64Value -> "Int64"
  SInt32Value -> "Int"
  SInt64Value -> "Int64"
  MessageValue reference -> reference.qualifier <> reference.name
  EnumValue reference -> reference.qualifier <> reference.name

defaultDeclaration :: MessageModel -> Array String
defaultDeclaration message =
  [ "default" <> message.name <> " :: " <> message.name ] <> case recordLines (map member message.members) of
    [ single ] -> [ "default" <> message.name <> " = " <> constructor <> single ]
    lines -> [ "default" <> message.name <> " =" <> (if message.recursive then " " <> message.name else "") ] <> indentBy 2 lines
  where
  constructor = if message.recursive then message.name <> " " else ""
  member = case _ of
    Plain field -> field.label <> ": " <> case field.shape of
      Repeated _ -> "[]"
      MapOf _ -> "Map.empty"
      _ -> initial field
    Oneof oneof -> oneof.label <> ": Nothing"

-- | What the decoder starts a field with: its default, or nothing yet.
initial :: Field -> String
initial field = case field.shape of
  Implicit -> zeroOf field.value
  Required -> zeroOf field.value
  Optional -> "Nothing"
  Repeated _ -> "Repeated.empty"
  MapOf _ -> "Repeated.empty"
  InOneof -> "Nothing"

zeroOf :: ValueType -> String
zeroOf = case _ of
  DoubleValue -> "0.0"
  FloatValue -> "0.0"
  Int64Value -> "zero"
  UInt64Value -> "(UInt64 zero)"
  Int32Value -> "0"
  Fixed64Value -> "(UInt64 zero)"
  Fixed32Value -> "(UInt32 0)"
  BoolValue -> "false"
  StringValue -> "\"\""
  BytesValue -> "Bytes.empty"
  UInt32Value -> "(UInt32 0)"
  SFixed32Value -> "0"
  SFixed64Value -> "zero"
  SInt32Value -> "0"
  SInt64Value -> "zero"
  MessageValue reference -> reference.qualifier <> "default" <> reference.name
  EnumValue reference -> reference.qualifier <> reference.zero

-- Decoding in a loop

-- | A loop variable of the decoder: a plain field, or a whole `oneof`.
type Variable = { name :: String, initial :: String, final :: String }

variablesOf :: MessageModel -> Array Variable
variablesOf message = map variableOf message.members
  where
  variableOf = case _ of
    Plain field -> { name: field.variable, initial: initial field, final: finalOf field }
    Oneof oneof -> { name: oneof.variable, initial: "Nothing", final: oneof.variable }
  finalOf field = case field.shape of
    Repeated _ -> "Repeated.freeze " <> field.variable
    MapOf _ -> "mapFromEntries " <> field.variable
    _ -> field.variable

-- | The fields of the message with the loop variable each one goes into.
fieldsOf :: MessageModel -> Array { field :: Field, into :: String, oneof :: Maybe String }
fieldsOf message = Array.concatMap fieldsOfMember message.members
  where
  fieldsOfMember = case _ of
    Plain field -> [ { field, into: field.variable, oneof: Nothing } ]
    Oneof oneof -> map (\field -> { field, into: oneof.variable, oneof: Just oneof.label }) oneof.fields

loopReader :: MessageModel -> Array String
loopReader message =
  [ "read" <> message.name <> " :: Reader " <> message.name ]
    <> readerLoop ("read" <> message.name) variables finish (Array.concatMap branches (fieldsOf message))
  where
  variables = variablesOf message
  finish = wrapped message (recordLines (map (\variable -> labelled variable) (Array.zip (map labelOf message.members) variables)))
  labelOf = case _ of
    Plain field -> field.label
    Oneof oneof -> oneof.label
  labelled (label /\ variable)
    | label == variable.final = label
    | otherwise = label <> ": " <> variable.final
  branches { field, into } = fieldBranches (map _.name variables) into (updateFor field) field

-- | Wraps the record in the newtype of a message that refers to itself.
wrapped :: MessageModel -> Array String -> Array String
wrapped message lines
  | message.recursive = case lines of
      [ single ] -> [ "(" <> message.name <> " " <> single <> ")" ]
      _ -> [ "(" <> message.name ] <> indentBy 4 lines <> [ "  )" ]
  | otherwise = lines

-- | How a value read for the field goes into its loop variable.
updateFor :: Field -> String -> String
updateFor field value = case field.shape of
  Implicit -> value
  Required -> value
  Optional -> "(Just " <> parenthesised value <> ")"
  Repeated _ -> "(Repeated.snoc " <> field.variable <> " " <> parenthesised value <> ")"
  MapOf _ -> "(Repeated.snoc " <> field.variable <> " " <> parenthesised value <> ")"
  InOneof -> "(Just (Variant.inj (Proxy :: _ \"" <> field.label <> "\") " <> parenthesised value <> "))"

-- | The decoder's loop, from `start` to `end`, which reads a field per step with `branches`.
readerLoop :: String -> Array Variable -> Array String -> Array (Array String) -> Array String
readerLoop name variables finish branches =
  [ name <> " = mkFn3 \\input start end -> do"
  , "  let"
  , "    loop " <> String.joinWith " " ([ "position" ] <> map _.name variables)
  ]
    <> finishLines
    <> [ "      | otherwise = do"
       , "          let afterTag = Wire.varintEnd input position end"
       , "          if afterTag < 0 then Left (failure afterTag position)"
       , "          else case Wire.varint32 input position of"
       ]
    <> indentBy 12 (Array.concat branches <> skipBranch)
    <> [ "  loop " <> String.joinWith " " ([ "start" ] <> map _.initial variables) ]
  where
  finishLines = case finish of
    [ single ] -> [ "      | position >= end = Right " <> single ]
    _ -> [ "      | position >= end = Right" ] <> indentBy 10 finish
  skipBranch =
    [ "tag -> do"
    , "  let next = Wire.skip input tag afterTag end"
    , "  if next < 0 then Left (failure next afterTag)"
    , "  else loop next " <> String.joinWith " " (map _.name variables)
    ]

-- | The `case` branches for a field's tags: one for its wire type, and for repeated numbers and
-- | enums one for the packed encoding too.
fieldBranches :: Array String -> String -> (String -> String) -> Field -> Array (Array String)
fieldBranches names into update field = case field.shape of
  Repeated _ | packable field.value -> [ single, packed ]
  MapOf entry -> [ entryBranch field.number entry.reader (\value -> loopWith (update value)) ]
  _ -> [ single ]
  where
  loopWith value = "loop next " <> String.joinWith " " (map (\name -> if name == into then value else name) names)
  single = singleBranch field.number field.value (\value -> loopWith (update value))
  packed = packedBranch field.number field.value (\values -> loopWith values) field.variable

singleBranch :: Int -> ValueType -> (String -> String) -> Array String
singleBranch number value continue = case wireType value of
  0 -> fixedWidth "Wire.varintEnd input afterTag end"
  1 -> fixedWidth "Wire.fixedEnd afterTag 8 end"
  5 -> fixedWidth "Wire.fixedEnd afterTag 4 end"
  _ -> delimited
  where
  tag = show (tagOf number (wireType value)) <> " -> do"
  fixedWidth nextAt =
    [ tag
    , "  let next = " <> nextAt
    , "  if next < 0 then Left (failure next afterTag)"
    , "  else " <> continue (readValue value "afterTag")
    ]
  delimited =
    [ tag
    , "  let payload = Wire.varintEnd input afterTag end"
    , "  let next = Wire.delimitedEnd input afterTag payload end"
    , "  if next < 0 then Left (failure next afterTag)"
    ]
      <> case value of
        StringValue ->
          [ "  else do"
          , "    let text = Wire.string input payload next"
          , "    if text == Wire.invalidUtf8 then Left (InvalidUtf8 payload)"
          , "    else " <> continue "text"
          ]
        BytesValue -> [ "  else " <> continue "(Wire.bytes input payload next)" ]
        MessageValue reference -> nested (reference.qualifier <> "read" <> reference.name)
        _ -> []
  nested reader =
    [ "  else case runFn3 " <> reader <> " input payload next of"
    , "    Left error -> Left error"
    , "    Right decoded -> " <> continue "decoded"
    ]

-- | A branch for a map field's entries, read with the entry's reader.
entryBranch :: Int -> String -> (String -> String) -> Array String
entryBranch number reader continue =
  [ show (tagOf number 2) <> " -> do"
  , "  let payload = Wire.varintEnd input afterTag end"
  , "  let next = Wire.delimitedEnd input afterTag payload end"
  , "  if next < 0 then Left (failure next afterTag)"
  , "  else case runFn3 " <> reader <> " input payload next of"
  , "    Left error -> Left error"
  , "    Right decoded -> " <> continue "decoded"
  ]

packedBranch :: Int -> ValueType -> (String -> String) -> String -> Array String
packedBranch number value continue values =
  [ show (tagOf number 2) <> " -> do"
  , "  let payload = Wire.varintEnd input afterTag end"
  , "  let next = Wire.delimitedEnd input afterTag payload end"
  , "  if next < 0 then Left (failure next afterTag)"
  ]
    <> case wireType value of
      0 ->
        [ "  else if not (Wire.packedVarintsValid input payload next) then Left (MalformedVarint payload)"
        , "  else " <> continue ("(" <> packedVarints <> " input payload next " <> values <> ")")
        ]
      width ->
        [ "  else if not (Wire.packedFixedValid payload next " <> show (widthOf width) <> ") then Left (Truncated payload)"
        , "  else " <> continue ("(Decode.packedFixed " <> show (widthOf width) <> " " <> fixedReader <> " input payload next " <> values <> ")")
        ]
  where
  widthOf wire = if wire == 1 then 8 else 4
  packedVarints = case value of
    Int32Value -> "packedInt32"
    EnumValue reference -> "Decode.packedVarints (\\bytes at -> " <> reference.qualifier <> "to" <> reference.name <> " (Wire.varint32 bytes at))"
    _ -> "Decode.packedVarints " <> varintReader
  varintReader = case value of
    Int64Value -> "Wire.varint64"
    UInt64Value -> "Wire.uint64"
    UInt32Value -> "Wire.uint32"
    SInt32Value -> "Wire.sint32"
    SInt64Value -> "Wire.sint64"
    BoolValue -> "Wire.bool"
    _ -> "Wire.varint32"
  fixedReader = case value of
    Fixed32Value -> "Wire.unsignedFixed32"
    SFixed32Value -> "Wire.fixed32"
    FloatValue -> "Wire.float"
    Fixed64Value -> "Wire.unsignedFixed64"
    SFixed64Value -> "Wire.fixed64"
    _ -> "Wire.double"

-- | Reads a value of a fixed width or a varint at `position`.
readValue :: ValueType -> String -> String
readValue value position = case value of
  Int32Value -> "(Wire.varint32 input " <> position <> ")"
  Int64Value -> "(Wire.varint64 input " <> position <> ")"
  UInt32Value -> "(Wire.uint32 input " <> position <> ")"
  UInt64Value -> "(Wire.uint64 input " <> position <> ")"
  SInt32Value -> "(Wire.sint32 input " <> position <> ")"
  SInt64Value -> "(Wire.sint64 input " <> position <> ")"
  BoolValue -> "(Wire.bool input " <> position <> ")"
  EnumValue reference -> "(" <> reference.qualifier <> "to" <> reference.name <> " (Wire.varint32 input " <> position <> "))"
  Fixed32Value -> "(Wire.unsignedFixed32 input " <> position <> ")"
  SFixed32Value -> "(Wire.fixed32 input " <> position <> ")"
  FloatValue -> "(Wire.float input " <> position <> ")"
  Fixed64Value -> "(Wire.unsignedFixed64 input " <> position <> ")"
  SFixed64Value -> "(Wire.fixed64 input " <> position <> ")"
  DoubleValue -> "(Wire.double input " <> position <> ")"
  _ -> ""

-- | The reader of a map field's entries.
entryReader :: MapEntry -> Array String
entryReader entry =
  [ entry.reader <> " :: Reader (Entry " <> parenthesised (valueType entry.key) <> " " <> parenthesised (valueType entry.value) <> ")" ]
    <> readerLoop entry.reader variables [ "{ key, value }" ] (map branch [ 1 /\ entry.key /\ "key", 2 /\ entry.value /\ "value" ])
  where
  variables =
    [ { name: "key", initial: zeroOf entry.key, final: "key" }
    , { name: "value", initial: zeroOf entry.value, final: "value" }
    ]
  branch (number /\ value /\ name) = singleBranch number value (\read -> "loop next " <> (if name == "key" then read <> " value" else "key " <> read))

-- Decoding in two steps

-- | Whether the message has enough fields to read them in two steps, and they're all plain
-- | values with numbers small enough to index an array by.
twoStep :: Options -> MessageModel -> Boolean
twoStep options message =
  Array.length message.members >= options.fieldsThreshold
    && Array.all plainValue message.members
    && fromMaybe 0 (maximum (map _.field.number (fieldsOf message))) <= 256
  where
  plainValue = case _ of
    Plain { shape: Implicit, value } -> case value of
      MessageValue _ -> false
      _ -> true
    _ -> false

fieldsReader :: MessageModel -> Array String
fieldsReader message =
  [ "read" <> message.name <> " :: Reader " <> message.name
  , "read" <> message.name <> " = mkFn3 \\input start end -> do"
  , "  let"
  , "    scan position fields"
  , "      | position >= end = Right fields"
  , "      | otherwise = do"
  , "          let afterTag = Wire.varintEnd input position end"
  , "          if afterTag < 0 then Left (failure afterTag position)"
  , "          else do"
  , "            let tag = Wire.varint32 input position"
  , "            let next = Wire.skip input tag afterTag end"
  , "            if next < 0 then Left (failure next afterTag)"
  , "            else scan next (Fields.note fields " <> wireTypesName <> " tag afterTag)"
  , "  case scan start (Fields.new input " <> show (largest + 1) <> ") of"
  , "    Left error -> Left error"
  , "    Right fields -> do"
  , "      let"
  , "        record ="
  ]
    <> indentBy 10 (recordLines (map (\{ field } -> field.label <> ": " <> fromFields field) fields))
    <> indentBy 6 checks
    <> [ ""
       , wireTypesName <> " :: Array Int"
       , wireTypesName <> " = [ " <> String.joinWith ", " (map wireTypeAt (Array.range 0 largest)) <> " ]"
       ]
  where
  fields = fieldsOf message
  largest = fromMaybe 0 (maximum (map _.field.number fields))
  wireTypesName = lowerFirst message.name <> "WireTypes"
  wireTypeAt number = case Array.find (\{ field } -> field.number == number) fields of
    Just { field } -> show (wireType field.value)
    Nothing -> "-1"
  strings = Array.filter (\{ field } -> field.value == StringValue) fields
  result = if message.recursive then "Right (" <> message.name <> " record)" else "Right record"
  checks = case strings of
    [] -> [ result ]
    _ ->
      Array.mapWithIndex (\index { field } -> (if index == 0 then "if " else "else if ") <> "record." <> field.label <> " == Wire.invalidUtf8 then Left (InvalidUtf8 (Fields.payloadStart input fields " <> show field.number <> " end))") strings
        <> [ "else " <> result ]

fromFields :: Field -> String
fromFields field = case field.value of
  Int32Value -> int32
  SFixed32Value -> fixed32
  SInt32Value -> "Wire.zigzag32 (" <> int32 <> ")"
  UInt32Value -> "UInt32 (" <> int32 <> ")"
  EnumValue reference -> reference.qualifier <> "to" <> reference.name <> " (" <> int32 <> ")"
  Int64Value -> int64
  SFixed64Value -> fixed64
  SInt64Value -> "Wire.zigzag64 (" <> int64 <> ")"
  UInt64Value -> "UInt64 (" <> int64 <> ")"
  Fixed32Value -> "UInt32 (" <> fixed32 <> ")"
  Fixed64Value -> "UInt64 (" <> fixed64 <> ")"
  BoolValue -> "runFn3 Fields.bool input fields " <> number
  DoubleValue -> "runFn3 Fields.double input fields " <> number
  FloatValue -> "runFn3 Fields.float input fields " <> number
  StringValue -> "runFn4 Fields.string input fields " <> number <> " end"
  BytesValue -> "runFn4 Fields.bytes input fields " <> number <> " end"
  MessageValue _ -> ""
  where
  number = show field.number
  int32 = "runFn3 Fields.int32 input fields " <> number
  int64 = "runFn3 Fields.int64 input fields " <> number
  fixed32 = "runFn3 Fields.fixed32 input fields " <> number
  fixed64 = "runFn3 Fields.fixed64 input fields " <> number

-- Encoding

writerDeclaration :: MessageModel -> Array String
writerDeclaration message = case writes of
  [] ->
    [ "write" <> message.name <> " :: Writer -> " <> message.name <> " -> Effect Unit"
    , "write" <> message.name <> " _ _ = pure unit"
    ]
  _ ->
    [ "write" <> message.name <> " :: Writer -> " <> message.name <> " -> Effect Unit"
    , "write" <> message.name <> " writer " <> pattern <> " = do"
    ]
      <> indentBy 2 (Array.concat writes)
  where
  pattern = if message.recursive then "(" <> message.name <> " message)" else "message"
  descending = Array.sortBy (\left right -> compare right.field.number left.field.number) (fieldsOf message)
  writes = map writeField descending

writeField :: { field :: Field, into :: String, oneof :: Maybe String } -> Array String
writeField { field, oneof } = case field.shape of
  Implicit ->
    [ "when " <> isSet field.value access <> " do" ] <> indentBy 2 (writeValue field.number field.value access)
  Required -> writeValue field.number field.value access
  Optional -> present access
  InOneof -> present (access <> " >>= Variant.prj (Proxy :: _ \"" <> field.label <> "\")")
  Repeated true ->
    [ "when (not (Array.null " <> access <> ")) do"
    , "  mark <- Writer.written writer"
    , "  Writer.eachDescending " <> access <> " \\item -> " <> writeBare field.value "item"
    , "  Writer.lengthSince writer mark"
    , "  Writer.tag writer " <> show (tagOf field.number 2)
    ]
  Repeated false ->
    [ "Writer.eachDescending " <> access <> " \\item -> do" ] <> indentBy 2 (writeValue field.number field.value "item")
  MapOf entry ->
    [ "Writer.eachEntryDescending " <> access <> " \\key value -> do"
    , "  mark <- Writer.written writer"
    ]
      <> indentBy 2 (writeEntryValue entry.value <> writeValue 1 entry.key "key")
      <> [ "  Writer.lengthSince writer mark"
         , "  Writer.tag writer " <> show (tagOf field.number 2)
         ]
  where
  access = "message." <> fromMaybe field.label oneof
  present scrutinee =
    [ "case " <> scrutinee <> " of"
    , "  Nothing -> pure unit"
    , "  Just " <> field.variable <> " -> do"
    ]
      <> indentBy 4 (writeValue field.number field.value field.variable)
  writeEntryValue value = case value of
    MessageValue reference ->
      [ "valueMark <- Writer.written writer"
      , reference.qualifier <> "write" <> reference.name <> " writer value"
      , "Writer.lengthSince writer valueMark"
      , "Writer.tag writer 18"
      ]
    _ -> writeValue 2 value "value"

-- | Writes the value and then its tag, as a back-to-front writer has to.
writeValue :: Int -> ValueType -> String -> Array String
writeValue number value expression = case value of
  MessageValue reference ->
    [ "mark <- Writer.written writer"
    , reference.qualifier <> "write" <> reference.name <> " writer " <> expression
    , "Writer.lengthSince writer mark"
    , "Writer.tag writer " <> show (tagOf number 2)
    ]
  _ ->
    [ writeBare value expression
    , "Writer.tag writer " <> show (tagOf number (wireType value))
    ]

-- | Writes the value without a tag.
writeBare :: ValueType -> String -> String
writeBare value expression = case value of
  DoubleValue -> "Writer.double writer " <> expression
  FloatValue -> "Writer.float writer " <> expression
  Int64Value -> "Writer.int64 writer " <> expression
  UInt64Value -> "Writer.int64 writer (un UInt64 " <> expression <> ")"
  Int32Value -> "Writer.int32 writer " <> expression
  Fixed64Value -> "Writer.fixed64 writer (un UInt64 " <> expression <> ")"
  Fixed32Value -> "Writer.fixed32 writer (un UInt32 " <> expression <> ")"
  BoolValue -> "Writer.bool writer " <> expression
  StringValue -> "Writer.string writer " <> expression
  BytesValue -> "Writer.bytes writer " <> expression
  UInt32Value -> "Writer.uint32 writer (un UInt32 " <> expression <> ")"
  SFixed32Value -> "Writer.fixed32 writer " <> expression
  SFixed64Value -> "Writer.fixed64 writer " <> expression
  SInt32Value -> "Writer.sint32 writer " <> expression
  SInt64Value -> "Writer.sint64 writer " <> expression
  EnumValue reference -> "Writer.int32 writer (" <> reference.qualifier <> "from" <> reference.name <> " " <> expression <> ")"
  MessageValue reference -> reference.qualifier <> "write" <> reference.name <> " writer " <> expression

-- | Whether a value differs from its default, so that a field without presence is written.
isSet :: ValueType -> String -> String
isSet value expression = case value of
  BoolValue -> expression
  DoubleValue -> "(" <> expression <> " /= 0.0)"
  FloatValue -> "(" <> expression <> " /= 0.0)"
  Int32Value -> "(" <> expression <> " /= 0)"
  SInt32Value -> "(" <> expression <> " /= 0)"
  SFixed32Value -> "(" <> expression <> " /= 0)"
  Int64Value -> "(" <> expression <> " /= zero)"
  SInt64Value -> "(" <> expression <> " /= zero)"
  SFixed64Value -> "(" <> expression <> " /= zero)"
  UInt32Value -> "(un UInt32 " <> expression <> " /= 0)"
  Fixed32Value -> "(un UInt32 " <> expression <> " /= 0)"
  UInt64Value -> "(un UInt64 " <> expression <> " /= zero)"
  Fixed64Value -> "(un UInt64 " <> expression <> " /= zero)"
  StringValue -> "(" <> expression <> " /= \"\")"
  BytesValue -> "(Bytes.length " <> expression <> " /= 0)"
  EnumValue reference -> "(" <> reference.qualifier <> "from" <> reference.name <> " " <> expression <> " /= 0)"
  MessageValue _ -> "true"

-- The wire format

wireType :: ValueType -> Int
wireType = case _ of
  DoubleValue -> 1
  Fixed64Value -> 1
  SFixed64Value -> 1
  FloatValue -> 5
  Fixed32Value -> 5
  SFixed32Value -> 5
  StringValue -> 2
  BytesValue -> 2
  MessageValue _ -> 2
  _ -> 0

tagOf :: Int -> Int -> Int
tagOf number wire = (number `shl` 3) .|. wire

-- Layout

-- | A record's fields one per line, or on one line if they're few and short.
recordLines :: Array String -> Array String
recordLines fields = case fields of
  [] -> [ "{}" ]
  _
    | String.length oneLine <= 60 -> [ oneLine ]
    | otherwise -> Array.mapWithIndex (\index field -> (if index == 0 then "{ " else ", ") <> field) fields <> [ "}" ]
  where
  oneLine = "{ " <> String.joinWith ", " fields <> " }"

indentBy :: Int -> Array String -> Array String
indentBy count = map \line -> if line == "" then line else spaces <> line
  where
  spaces = foldMap (const " ") (Array.range 1 count)

parenthesised :: String -> String
parenthesised text
  | String.contains (Pattern " ") text && not (String.take 1 text == "(" || String.take 1 text == "{") = "(" <> text <> ")"
  | otherwise = text

lowerFirst :: String -> String
lowerFirst name = String.toLower (String.take 1 name) <> String.drop 1 name
