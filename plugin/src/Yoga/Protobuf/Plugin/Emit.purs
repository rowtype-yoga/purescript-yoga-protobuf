-- | The PureScript module for one `.proto` file.
-- |
-- | Each message becomes a record type with a default value, a decoder, an encoder and a codec.
-- | Each enum becomes a data type with a constructor for numbers it doesn't know.
module Yoga.Protobuf.Plugin.Emit
  ( Options
  , moduleFor
  ) where

import Prelude

import Data.Array as Array
import Data.Maybe (Maybe)
import Data.String as String

import Yoga.Protobuf.Plugin.Emit.Code (indentBy, initial, parenthesised, recordLines, valueType)
import Yoga.Protobuf.Plugin.Emit.Decoder (entryReader, reader)
import Yoga.Protobuf.Plugin.Emit.Encoder (writer)
import Yoga.Protobuf.Plugin.Imports (importsFor)
import Yoga.Protobuf.Plugin.Names (lowerFirst)
import Yoga.Protobuf.Plugin.Schema (EnumModel, Field, FileModel, Member(..), MessageModel, Shape(..))

-- | `fieldsThreshold`: if there is one, messages with at least this many fields, all of them
-- | plain values, are decoded in two steps (see `Yoga.Protobuf.Fields`).
type Options = { fieldsThreshold :: Maybe Int }

-- | The module's text, laid out as purs-tidy would.
moduleFor :: Options -> FileModel -> String
moduleFor options file = String.joinWith "\n" lines <> "\n"
  where
  lines = case exports of
    -- A file of only imports or services: a module with nothing in it.
    [] -> [ documentation, "module " <> file.moduleName <> " where" ]
    _ -> [ documentation, "module " <> file.moduleName ] <> exportList exports <> [ "" ] <> importsFor file.imports body <> [ "" ] <> body
  documentation = "-- | Generated by protoc-gen-purescript from " <> file.protoName <> ". Don't edit it by hand."
  exports = Array.concatMap enumExports file.enums <> Array.concatMap messageExports file.messages
  body = Array.intercalate [ "" ] (map enumDeclarations file.enums <> map (messageDeclarations options) file.messages)

exportList :: Array String -> Array String
exportList exports = Array.mapWithIndex (\index export -> (if index == 0 then "  ( " else "  , ") <> export) exports <> [ "  ) where" ]

enumExports :: EnumModel -> Array String
enumExports enum = [ enum.name <> "(..)", "to" <> enum.name, "from" <> enum.name ]

messageExports :: MessageModel -> Array String
messageExports message =
  [ if message.recursive then message.name <> "(..)" else message.name
  , "default" <> message.name
  , lowerFirst message.name <> "Codec"
  , "decode" <> message.name
  , "encode" <> message.name
  , "read" <> message.name
  , "write" <> message.name
  ]

-- Enums

enumDeclarations :: EnumModel -> Array String
enumDeclarations enum = Array.intercalate [ "" ]
  [ [ "-- | `" <> enum.fullName <> "`. `" <> enum.unrecognized <> "` keeps a number the enum doesn't have." ]
      <> [ "data " <> enum.name ]
      <> Array.mapWithIndex (\index constructor -> (if index == 0 then "  = " else "  | ") <> constructor) (map _.constructor enum.constructors <> [ enum.unrecognized <> " Int" ])
  , [ "derive instance Eq " <> enum.name ]
  , [ "-- | By number, as other implementations sort them."
    , "instance Ord " <> enum.name <> " where"
    , "  compare left right = compare (from" <> enum.name <> " left) (from" <> enum.name <> " right)"
    ]
  , [ "instance Show " <> enum.name <> " where"
    , "  show = case _ of"
    ]
      <> map (\{ constructor } -> "    " <> constructor <> " -> \"" <> constructor <> "\"") enum.constructors
      <> [ "    " <> enum.unrecognized <> " number -> \"(" <> enum.unrecognized <> " \" <> show number <> \")\"" ]
  , [ "-- | The constructor for a number."
    , "to" <> enum.name <> " :: Int -> " <> enum.name
    , "to" <> enum.name <> " = case _ of"
    ]
      <> map (\{ constructor, number } -> "  " <> show number <> " -> " <> constructor) (Array.nubBy (comparing _.number) enum.constructors)
      <> [ "  number -> " <> enum.unrecognized <> " number" ]
  , [ "-- | The number of a constructor."
    , "from" <> enum.name <> " :: " <> enum.name <> " -> Int"
    , "from" <> enum.name <> " = case _ of"
    ]
      <> map (\{ constructor, number } -> "  " <> constructor <> " -> " <> show number) enum.constructors
      <> [ "  " <> enum.unrecognized <> " number -> number" ]
  ]

-- Messages

messageDeclarations :: Options -> MessageModel -> Array String
messageDeclarations options message = Array.intercalate [ "" ] (declarations <> map entryReader message.entries)
  where
  codecName = lowerFirst message.name <> "Codec"
  declarations =
    [ typeDeclaration message
    , [ "-- | Every field at its default: what decoding no bytes gives." ] <> defaultDeclaration message
    , [ "-- | Decodes and encodes `" <> message.name <> "`."
      , codecName <> " :: Codec " <> message.name
      , codecName <> " = codec read" <> message.name <> " write" <> message.name
      ]
    , [ "-- | Broken input is a `Left` that says where it went wrong."
      , "decode" <> message.name <> " :: Bytes -> Either DecodeError " <> message.name
      , "decode" <> message.name <> " input = decodeMessage read" <> message.name <> " input"
      ]
    , [ "-- | The fields in the order of their numbers; a map's entries in the order of their keys."
      , "encode" <> message.name <> " :: " <> message.name <> " -> Bytes"
      , "encode" <> message.name <> " message = encodeWith write" <> message.name <> " message"
      ]
    , [ "-- | Reads `" <> message.name <> "` from the bytes between two positions, for the messages it's in." ]
        <> reader options.fieldsThreshold message
    , [ "-- | Writes `" <> message.name <> "` back to front, for the messages it's in." ] <> writer message
    ]

typeDeclaration :: MessageModel -> Array String
typeDeclaration message = [ documentation ] <> declaration
  where
  declaration
    | message.recursive =
        [ "newtype " <> message.name <> " = " <> message.name ]
          <> indentBy 2 (recordType message)
          <> [ ""
             , "derive instance Newtype " <> message.name <> " _"
             , ""
             , "derive instance Eq " <> message.name
             , ""
             , "instance Show " <> message.name <> " where"
             , "  show value = \"(" <> message.name <> " \" <> show (un " <> message.name <> " value) <> \")\""
             ]
    | otherwise = case recordType message of
        [ single ] -> [ "type " <> message.name <> " = " <> single ]
        lines -> [ "type " <> message.name <> " =" ] <> indentBy 2 lines
  documentation = "-- | `" <> message.fullName <> "`" <> (if message.recursive then ", a newtype because it refers to itself." else ".")

recordType :: MessageModel -> Array String
recordType message = recordLines (map member message.members)
  where
  member = case _ of
    Plain field -> field.label <> " :: " <> fieldType field
    Oneof oneof -> oneof.label <> " :: Maybe (Variant (" <> String.joinWith ", " (map (\field -> field.label <> " :: " <> valueType field.value) oneof.fields) <> "))"

fieldType :: Field -> String
fieldType field = case field.shape of
  Implicit -> valueType field.value
  Required -> valueType field.value
  Optional -> "Maybe " <> parenthesised (valueType field.value)
  Repeated _ -> "Array " <> parenthesised (valueType field.value)
  MapOf entry -> "Map " <> parenthesised (valueType entry.key) <> " " <> parenthesised (valueType entry.value)
  InOneof -> valueType field.value

defaultDeclaration :: MessageModel -> Array String
defaultDeclaration message =
  [ "default" <> message.name <> " :: " <> message.name ] <> case recordLines (map member message.members) of
    [ single ] -> [ "default" <> message.name <> " = " <> constructor <> single ]
    lines -> [ "default" <> message.name <> " =" <> (if message.recursive then " " <> message.name else "") ] <> indentBy 2 lines
  where
  constructor = if message.recursive then message.name <> " " else ""
  member = case _ of
    Plain field -> field.label <> ": " <> defaultOf field
    Oneof oneof -> oneof.label <> ": Nothing"
  defaultOf field = case field.shape of
    Repeated _ -> "[]"
    MapOf _ -> "Map.empty"
    Implicit -> initial field
    Required -> initial field
    Optional -> initial field
    InOneof -> initial field
