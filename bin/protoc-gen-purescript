#!/usr/bin/env bash
# protoc-gen-purescript, the native binary Iris builds:
#
#   iris go -p protoc-gen-purescript --entry Yoga.Protobuf.Plugin.Native.main
#   protoc --plugin=protoc-gen-purescript=bin/protoc-gen-purescript --purescript_out=src foo.proto
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
binary="$root/.spago/go/protoc-gen-purescript/bin/protoc-gen-purescript"
if [[ ! -x "$binary" ]]; then
  echo "protoc-gen-purescript isn't built yet: iris go -p protoc-gen-purescript --entry Yoga.Protobuf.Plugin.Native.main" >&2
  exit 1
fi
exec "$binary" "$@"
